# ─────────────────────────────────────────────────────────────
# ClipLive — variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# No pongas comillas ni espacios alrededor del "=".
# ─────────────────────────────────────────────────────────────

# URL donde corre la web (en local no hace falta cambiarla)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (supabase.com) ──────────────────────────────────
# Panel del proyecto → Project Settings → API
# "Project URL", p. ej. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" key (¡SECRETA! nunca la compartas ni la subas a GitHub)
SUPABASE_SERVICE_ROLE_KEY=

# ── Almacenamiento de clips: Supabase Storage ─────────────────
# Bucket privado del mismo proyecto de Supabase (se crea solo). No necesita más claves.
STORAGE_BUCKET=clips

# ── Stripe (dashboard.stripe.com, usa el modo de pruebas) ────
# Developers → API keys → "Secret key" (empieza por sk_test_)
STRIPE_SECRET_KEY=
# Lo da el comando: stripe listen --forward-to localhost:3000/api/webhook
# (empieza por whsec_)
STRIPE_WEBHOOK_SECRET=
# Product catalog → crea 4 productos con precio RECURRENTE en USD y copia el ID de cada precio (price_...):
#   Starter $9 cada 1 mes · Creator $24 cada 2 meses · Pro $59 cada 5 meses · Premium $99 cada 1 año
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=

# ── Worker ───────────────────────────────────────────────────
# Cuántos clips procesa a la vez
WORKER_CONCURRENCY=2

# Muestra el botón "Continuar con Google" (ponlo en true cuando actives Google en Supabase)
NEXT_PUBLIC_GOOGLE_LOGIN=false

# Administradores (usuarios o correos, separados por comas): clips ilimitados con límites del plan Pro
ADMIN_USERS=
